---
interface Props {
  cityName?: string;
  subtitle?: string;
  title?: string;
  description?: string;
  defaultCity?: string;
}

const {
  cityName,
  subtitle = cityName ? `DON'T TAKE RISKS WITH YOUR JOB` : `Don't Take Risks With Your Job`,
  title = cityName ? `Get Your Quality Dumpster Delivered When You Need It in ${cityName}` : `Get Your Quality Dumpster Delivered When You Need It`,
  description = cityName
    ? `Skip the middleman call centers and surprise weight fees. Dumpsters Now delivers clean, driveway-safe roll-off containers across ${cityName}, MI with transparent flat rates and local phone support.`
    : `Skip the middleman call centers and surprise weight fees. Dumpsters Now delivers clean, driveway-safe roll-off containers with transparent flat rates and local phone support.`,
  defaultCity = cityName || ""
} = Astro.props;
---

<section class="quote-section" id="get-started">
  <div class="container quote-grid">
    <div class="quote-info">
      <div class="section-subtitle">{subtitle}</div>
      <h2 class="section-title">{title}</h2>
      <p class="quote-desc">
        {description}<br><br>
        Call (888) 870-9906 or reserve online in under 2 minutes!
      </p>

      <div class="google-review-badge">
        <img src="/assets/images/icons8-google-48.png" alt="Google logo" style="width:36px;">
        <div>
          <div class="stars" style="color:var(--star-gold)">★★★★★</div>
          <div style="font-size:0.85rem; font-weight:700;">5.0 Average on Google Reviews</div>
        </div>
      </div>
    </div>

    <div class="quote-form-card">
      <div class="stars" style="color:var(--star-gold); margin-bottom:10px;">★★★★★</div>
      <h3>One Flat Price. No Hidden Fees. No Weight Surprises.</h3>
      <p>Lock in your flat-rate delivery date. Same-day & next-day dispatch available across Wayne, Oakland, and Macomb counties.</p>

      <form id="quoteForm">
        <div class="form-group">
          <label class="form-label" for="name">Your Name <span>*</span></label>
          <input type="text" id="name" name="name" class="form-input" required placeholder="John Doe">
        </div>

        <div class="form-group">
          <label class="form-label" for="email">Your Email <span>*</span></label>
          <input type="email" id="email" name="email" class="form-input" required placeholder="john@example.com">
        </div>

        <div class="form-group">
          <label class="form-label" for="phone">Phone Number <span>*</span></label>
          <input type="tel" id="phone" name="phone" class="form-input" required placeholder="(888) 870-9906">
        </div>

        <div class="form-group">
          <label class="form-label" for="city">City <span>*</span></label>
          <input type="text" id="city" name="city" class="form-input" required placeholder="e.g. Detroit, Livonia, Canton" value={defaultCity}>
        </div>

        <div class="form-group">
          <label class="form-label">What size dumpster do you need? <span>*</span></label>
          <div class="radio-group">
            <div class="radio-btn-option">
              <input type="radio" id="size15" name="dumpster_size" value="15 Yard" required>
              <label for="size15">15 Yard</label>
            </div>
            <div class="radio-btn-option">
              <input type="radio" id="size20" name="dumpster_size" value="20 Yard">
              <label for="size20">20 Yard</label>
            </div>
            <div class="radio-btn-option">
              <input type="radio" id="size30" name="dumpster_size" value="30 Yard">
              <label for="size30">30 Yard</label>
            </div>
            <div class="radio-btn-option">
              <input type="radio" id="size40" name="dumpster_size" value="40 Yard">
              <label for="size40">40 Yard</label>
            </div>
            <div class="radio-btn-option">
              <input type="radio" id="sizeNotsure" name="dumpster_size" value="Not Sure">
              <label for="sizeNotsure">Not sure</label>
            </div>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">How soon do you need the dumpster? <span>*</span></label>
          <div class="radio-group">
            <div class="radio-btn-option">
              <input type="radio" id="timeToday" name="how_soon" value="Today" required>
              <label for="timeToday">Today</label>
            </div>
            <div class="radio-btn-option">
              <input type="radio" id="time3Days" name="how_soon" value="Within 3 days">
              <label for="time3Days">Within 3 days</label>
            </div>
            <div class="radio-btn-option">
              <input type="radio" id="timeWeek" name="how_soon" value="Within a week">
              <label for="timeWeek">Within a week</label>
            </div>
            <div class="radio-btn-option">
              <input type="radio" id="timeLater" name="how_soon" value="Much later">
              <label for="timeLater">Much later</label>
            </div>
          </div>
        </div>

        <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:25px; font-size:1rem;">
          {cityName ? `Get ${cityName} Dumpster Rental Quote` : `Get Your Dumpster Rental Quote`}
        </button>
      </form>
    </div>
  </div>
</section>
