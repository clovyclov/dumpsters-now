  canonical="https://dumpstersnow.com/construction-debris-dumpster-rentals/"
  activePage="services"
>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="banner-pill">C&D Waste Management Specialists</span>

        <h1 class="hero-title">
          Heavy C&D Waste Construction Dumpster Rentals
        </h1>

        <p style="font-size:1.15rem; color:#e2e8f0; margin-bottom:25px;">
          Built to haul heavy construction demolition, roofing shingles, drywall, tile, and masonry with guaranteed same-day job-site delivery.
        </p>

        <ul class="hero-features">
          <li>
            <div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>
            Handles drywall, lumber, roofing shingles, masonry & concrete
