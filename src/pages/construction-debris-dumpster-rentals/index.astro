        <a href="/book-now/" class="btn btn-red">Schedule Construction Dumpster</a>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.53.00 PM.jpeg" alt="Construction Debris Removal Dumpster Delivery Truck" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

