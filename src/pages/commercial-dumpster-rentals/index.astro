---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Commercial Roll-Off Dumpster Rentals Metro Detroit | Contractor Waste"
  description="Commercial roll-off dumpster rentals in Metro Detroit. Heavy-duty 15, 20, 30 & 40 yard containers for retail remodels, office cleanouts, property managers & job sites."
  canonical="https://dumpstersnow.com/commercial-dumpster-rentals/"
  activePage="services"
>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="banner-pill">Commercial Waste Solutions</span>

        <h1 class="hero-title">
          Commercial Roll-Off Dumpster Rentals for Contractors
        </h1>

        <p style="font-size:1.15rem; color:#e2e8f0; margin-bottom:25px;">
          Fast job-site dispatch, scheduled swap-outs, and flexible business billing for general contractors, property managers, and retail build-outs across Southeast Michigan.
        </p>

        <ul class="hero-features">
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Scheduled container swap-out & empty service</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Heavy-duty 15, 20, 30 & 40 yard roll-off capacity</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Direct invoice billing for business & contractor accounts</li>
        </ul>

        <a href="/book-now/" class="btn btn-red">Book Commercial Container</a>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.53.00 PM.jpeg" alt="Commercial Dumpster Rental Metro Detroit" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- ==================== COMMERCIAL VALUE PROPS ==================== -->
  <section class="seo-section-cream">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Engineered for Businesses & Job Sites</div>
        <h2 class="section-title">Why Metro Detroit Contractors Choose Dumpsters Now</h2>
        <p style="font-size:1.05rem; color:#475569; max-width:800px; margin:15px auto 0;">
          Keeping commercial jobs on schedule requires a waste partner who communicates clearly and delivers on time.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin-top: 35px;">
        <div style="background:#fff; border:3px solid #000; box-shadow:6px 6px 0px #000; border-radius:12px; padding:25px;">
          <h3 style="font-size:1.25rem; font-weight:900; margin-bottom:10px; color:#1e293b;">⚡ Rapid Job-Site Dispatch</h3>
          <p style="color:#475569; font-size:0.98rem; line-height:1.5;">Need a container swap-out today? Our Northville dispatch hub coordinates fast drop-offs and pickups so your sub-contractors never stand idle.</p>
        </div>
        <div style="background:#fff; border:3px solid #000; box-shadow:6px 6px 0px #000; border-radius:12px; padding:25px;">
          <h3 style="font-size:1.25rem; font-weight:900; margin-bottom:10px; color:#1e293b;">🏢 Corporate Account Billing</h3>
          <p style="color:#475569; font-size:0.98rem; line-height:1.5;">We simplify commercial accounting with itemized invoices, PO number tracking, and flexible payment terms for recurring contractor accounts.</p>
        </div>
        <div style="background:#fff; border:3px solid #000; box-shadow:6px 6px 0px #000; border-radius:12px; padding:25px;">
          <h3 style="font-size:1.25rem; font-weight:900; margin-bottom:10px; color:#1e293b;">🛡️ Parking Lot Protection</h3>
          <p style="color:#475569; font-size:0.98rem; line-height:1.5;">Our drivers utilize heavy-duty protective wooden boards under roll-off wheels to protect commercial asphalt and concrete paving.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PRICING / SIZES SECTION (ALL 4 SIZES) ==================== -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Commercial Dumpster Sizes</div>
        <h2 class="section-title">Select the Ideal Commercial Dumpster Size</h2>
      </div>

      <div class="pricing-grid">
        <!-- 15 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$375</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="15 Yard Commercial Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Small office cleanouts & retail waste</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Tight alleyway or commercial parking access</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 15 Yard</a></div>
        </div>

        <!-- 20 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$425</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="20 Yard Commercial Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Retail store interior remodels</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Office furniture & document purges</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 20 Yard</a></div>
        </div>

        <!-- 30 Yard -->
        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$465</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="30 Yard Commercial Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Large commercial renovations</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Property manager apartment turnovers</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-red btn-block">Rent 30 Yard</a></div>
        </div>

        <!-- 40 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">40 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$550</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="40 Yard Commercial Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Major commercial demolition</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Industrial facility build-outs</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 40 Yard</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 1: Image Left, Content Right -->
  <section style="padding: 60px 0; background: white;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dump-truck-1.webp" alt="Heavy duty commercial roll-off truck" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
        <div>
          <div class="section-subtitle">Commercial & Property Solutions</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Reliable Roll-Off Containers for Contractors & Business Owners</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Keep commercial job sites, retail build-outs, and multi-family cleanouts running on schedule. We provide heavy-duty 20, 30, and 40-yard dumpsters backed by priority commercial dispatch.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Dedicated commercial account support for fast scheduling & invoicing</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Fast swap-out service available within 24 hours for active commercial sites</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> High weight allowances tailored for heavy commercial & construction waste</li>
          </ul>
          <a href="tel:888-870-9906" class="btn btn-red">Call Commercial Line: (888) 870-9906</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 2: Content Left, Image Right -->
  <section style="padding: 60px 0; background: var(--bg-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div>
          <div class="section-subtitle">Heavy-Duty Business Waste</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Reinforced Steel Containers Built for Heavy Commercial Waste</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            From office overhauls and tenant turn-overs to major retail teardowns, our heavy-gauge commercial roll-off containers handle high-density materials with complete safety.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Up to 5-ton (10,000 lbs) weight allowances on 40-yard commercial bins</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Heavy-duty swinging rear doors for easy skid & machinery loading</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Flexible commercial rental agreements & scheduled recurring deliveries</li>
          </ul>
          <a href="#get-started" class="btn btn-green">Rent Commercial Dumpster →</a>
        </div>
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dumpstersnow-real-2.webp" alt="Commercial roll-off dumpster on truck" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
      </div>
    </div>
  </section>


  <!-- ==================== LOCAL GEO SERVICE AREA SECTION ==================== -->
  <section class="seo-section-cream">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Local Business Service Area</div>
        <h2 class="section-title">Commercial Dumpster Rental Service Cities</h2>
      </div>

      <div class="geo-city-grid">
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Detroit, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Troy, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Royal Oak, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Sterling Heights, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Warren, MI</div>
        <div class="geo-city-card"><svg viewBox="0 0 32 32"><path d="M16 0c-5.523 0-10 4.477-10 10 0 10 10 22 10 22s10-12 10-22c0-5.523-4.477-10-10-10zM16 14c-2.209 0-4-1.791-4-4s1.791-4 4-4 4 1.791 4 4-1.791 4-4 4z"/></svg> Livonia, MI</div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIALS SECTION ==================== -->
  <TestimonialSlider />

  <!-- ==================== QUOTE FORM SECTION ==================== -->
  <section class="quote-section" id="get-started">
    <div class="container quote-grid">
      <div class="quote-info">
        <div class="section-subtitle">Commercial Waste Experts</div>
        <h2 class="section-title">Get Commercial Waste Scheduled Right On Time</h2>
        <p class="quote-desc">Need ongoing swaps or multi-container site rentals? Fill out the form or call (888) 870-9906.</p>
      </div>

      <div class="quote-form-card">
        <form id="quoteForm">
          <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:25px;">Get Commercial Dumpster Quote</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>