---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Junk Removal Dumpster Rentals Metro Detroit | Fast Delivery"
  description="Rent junk removal dumpsters in Metro Detroit. Perfect for house cleanouts, estate purges, furniture, trash & clutter. Flat-rate transparent pricing."
  canonical="https://dumpstersnow.com/junk-removal-dumpsters/"
  activePage="services"
>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="banner-pill">Full Home & Estate Cleanouts</span>

        <h1 class="hero-title">
          Junk Removal & Estate Cleanout Dumpsters
        </h1>

        <p style="font-size:1.15rem; color:#e2e8f0; margin-bottom:25px;">
          Declutter at your own pace with a 7-day flat-rate roll-off container. Walk-in rear doors make loading heavy furniture, couches, and old appliances effortless.
        </p>

        <ul class="hero-features">
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Keep the dumpster up to 7 full days</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Easy rear walk-in loading doors</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Flat-rate pricing with zero hidden weight fees</li>
        </ul>

        <a href="/book-now/" class="btn btn-red">Book Junk Dumpster</a>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.53.15 PM.jpeg" alt="Junk Removal Dumpster Rental Metro Detroit" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- ==================== PRICING / SIZES SECTION (ALL 4 SIZES) ==================== -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Junk Removal Sizes</div>
        <h2 class="section-title">Select Your Cleanout & Junk Removal Dumpster Size</h2>
      </div>

      <div class="pricing-grid">
        <!-- 15 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$375</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="15 Yard Junk Removal Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Garage & basement decluttering</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Old furniture & mattress disposal</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 15 Yard</a></div>
        </div>

        <!-- 20 Yard -->
        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$425</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="20 Yard Junk Removal Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Multi-room home cleanouts</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Estate property liquidation</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-red btn-block">Rent 20 Yard</a></div>
        </div>

        <!-- 30 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$465</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="30 Yard Junk Removal Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Whole-house decluttering & move-outs</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Foreclosure & eviction cleanouts</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 30 Yard</a></div>
        </div>

        <!-- 40 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">40 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$550</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="40 Yard Junk Removal Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Major commercial junk cleanouts</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Hoarder & large estate trash purges</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 40 Yard</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 1: Image Left, Content Right -->
  <section style="padding: 60px 0; background: white;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/20230605_104913.webp" alt="Dumpster rental for DIY estate and home cleanout" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
        <div>
          <div class="section-subtitle">DIY Estate & Property Cleanouts</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Purge Whole-House Clutter On Your Own Terms</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Need to clear out an estate, prepare a house for sale, or purge decades of attic and basement clutter? Dumpsters Now gives you the freedom to sort and throw away items at your own pace.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Save 50%+ compared to expensive full-service junk removal crews</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Walk-in rear doors for effortless loading of mattresses, couches & furniture</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Generous 7-day rental period so you never feel rushed during cleanouts</li>
          </ul>
          <a href="tel:888-870-9906" class="btn btn-red">Call Cleanout Line: (888) 870-9906</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 2: Content Left, Image Right -->
  <section style="padding: 60px 0; background: var(--bg-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div>
          <div class="section-subtitle">Fast Clutter Clearance</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Driveway Protection Guarantee & Rapid Local Dispatch</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Protect your property while clearing out unwanted clutter. We place heavy wooden skids under every wheel to safeguard your driveway surface.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Accepts furniture, appliances, boxes, carpet, clothing & general junk</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Same-day delivery available across Wayne, Oakland & Macomb counties</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Clean, well-maintained containers suitable for residential neighborhoods</li>
          </ul>
          <a href="#get-started" class="btn btn-green">Rent Cleanout Dumpster →</a>
        </div>
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dumpstersnow-real-6.webp" alt="Dumpsters Now delivery truck delivering container" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
      </div>
    </div>
  </section>


  <TestimonialSlider />

  <section class="quote-section" id="get-started">
    <div class="container quote-grid">
      <div class="quote-info">
        <div class="section-subtitle">Declutter Today</div>
        <h2 class="section-title">Schedule Your Junk Removal Dumpster Delivery</h2>
        <p class="quote-desc">Get your dumpster dropped off right when you need it. Call (888) 870-9906.</p>
      </div>

      <div class="quote-form-card">
        <form id="quoteForm">
          <div class="form-group"><label class="form-label" for="name">Your Name <span>*</span></label><input type="text" id="name" class="form-input" required placeholder="John Doe"></div>
          <div class="form-group"><label class="form-label" for="email">Your Email <span>*</span></label><input type="email" id="email" class="form-input" required placeholder="john@example.com"></div>
          <div class="form-group"><label class="form-label" for="phone">Phone Number <span>*</span></label><input type="tel" id="phone" class="form-input" required placeholder="(888) 870-9906"></div>
          <div class="form-group"><label class="form-label" for="city">City <span>*</span></label><input type="text" id="city" name="city" class="form-input" required placeholder="e.g. Detroit, Livonia, Canton"></div>
          <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:25px;">Get Junk Removal Quote</button>
        </form>
      </div>
    </div>
  </section>

  <section class="pre-footer-banner">
    <div class="container pre-footer-content">
      <div class="pre-footer-text">
        Get a reliable, convenient, and on-time dumpster delivered straight to your driveway.
      </div>
      <a href="/book-now/" class="btn btn-red">Book Online Today</a>
    </div>
  </section>
</BaseLayout>
