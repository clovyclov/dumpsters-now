---
import BaseLayout from '../layouts/BaseLayout.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import QuoteFormSection from '../components/QuoteFormSection.astro';

const faqSchema = [
  {
    question: "Will my dumpster have a door that swings open?",
    answer: "Yes. Every roll-off container delivered by Dumpsters Now features heavy-duty rear walk-in doors that swing open wide. This allows you to walk heavy furniture, drywall sheets, and bulky debris directly into the dumpster without lifting items over high side walls."
  },
  {
    question: "Does the dumpster have a cover or lid?",
    answer: "Roll-off containers are open-top by design for efficient loading. If your dumpster sits outside during rain or snow, covering it with a tarp is a smart way to keep water out and prevent neighborhood trash dumping."
  },
  {
    question: "How is the weight of my debris determined?",
    answer: "Weight is measured accurately at certified Michigan disposal facilities. The delivery truck weighs in upon arrival and weighs out after emptying. The net difference represents your exact debris weight. All facility scales are regulated by the State Bureau of Weights and Measures."
  },
  {
    question: "What type of trash may incur extra costs?",
    answer: "Large and bulky electronic waste items, mattresses, tires, and items containing freon may incur a per-item fee at the disposal facility. Contact us for specific item details."
  },
  {
    question: "What materials are prohibited?",
    answer: "To comply with Michigan DEQ and landfill safety regulations, we cannot accept hazardous materials. Prohibited items include wet paint, motor oil, gasoline, propane cylinders, asbestos, car batteries, biohazardous waste, and industrial solvents."
  },
  {
    question: "What does the price include?",
    answer: "Our flat-rate pricing is 100% transparent and all-inclusive. Your quoted price covers initial drop-off delivery, final pickup haul-away, a generous tonnage weight allowance, driveway protection, and a standard 7-day rental period."
  },
  {
    question: "How many tons can I put in my roll off dumpster?",
    answer: "This depends on the size of the dumpster you rent. The Department of Transportation regulations limit the weight of any roll off dumpster to approximately 15 tons."
  },
  {
    question: "Will I be billed for extra weight?",
    answer: "Yes. If the weight of the materials in your dumpster exceeds the included weight quoted in your order confirmation, you will be charged for the additional weight."
  }
];
