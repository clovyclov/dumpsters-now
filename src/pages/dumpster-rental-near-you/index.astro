---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Same-Day Dumpster Rental Metro Detroit | Flat-Rate Pricing | Dumpsters Now"
  description="Rent a roll-off dumpster in Metro Detroit fast! 15, 20, 30 & 40 yard dumpsters with flat-rate transparent pricing, driveway protection & same-day delivery. Call 888-870-9906."
  canonical="https://dumpstersnow.com/dumpster-rental-near-you/"
  noindex={true}
  hideHeader={true}
  activePage="landing"
  isPPC={true}
>
  <!-- ==================== PPC HIGH-CONVERSION HEADER ==================== -->
  <header class="ppc-header">
    <div class="container ppc-header-container">
      <a href="/" class="logo-link">
        <img src="/assets/images/dumpster-now-logo.png" alt="Dumpsters Now Logo" style="max-height: 50px;">
      </a>

      <div class="header-review-badge" style="display: flex; flex-direction: column; align-items: center; gap: 2px; border: 1px solid #e2e8f0; border-radius: 10px; padding: 6px 16px;">
        <div style="display: flex; align-items: center; gap: 6px;">
          <img src="/assets/images/icons8-google-48.png" alt="Google" style="width: 16px; height: 16px;">
          <span style="color: #f59e0b; font-size: 0.85rem; letter-spacing: 1px;">★★★★★</span>
        </div>
        <div style="font-weight: 800; font-size: 0.85rem; color: #1a73e8;">5.0 from 120+ Reviews</div>
        <div style="font-style: italic; font-size: 0.75rem; color: #64748b;">800+ Happy Customers!</div>
      </div>

      <div class="ppc-phone-badge">
        <div style="text-align: right; display: none; @media(min-width: 600px){display:block;}">
          <div style="font-size: 0.78rem; font-weight: 800; text-transform: uppercase; color: #64748b;">Need A Dumpster Today?</div>
          <a href="tel:888-870-9906" class="ppc-phone-number">(888) 870-9906</a>
        </div>
        <a href="tel:888-870-9906" class="btn btn-red" style="font-size: 1rem; padding: 12px 22px;">CALL US (888) 870-9906</a>
      </div>
    </div>
  </header>

  <!-- ==================== HERO SECTION WITH CONVERSION FORM ==================== -->
  <section class="hero-section" style="background: #0f172a; padding: 50px 0 70px; border-bottom: 3px solid #1e293b;">
    <div class="container">
      <div class="hero-grid" style="align-items: center;">
        
        <!-- Left Hero Offer Copy -->
        <div class="hero-offer-content">
          <div class="rating-badge" style="margin-bottom: 18px;">
            <span class="stars" style="color: var(--star-gold);">★★★★★</span>
            <span style="font-weight: 800; font-size: 0.9rem;">5.0 Rating (120+ Google Reviews)</span>
          </div>

          <h1 id="hero-headline" class="hero-title" style="line-height: 1.15; margin-bottom: 20px;">
            Rent A Dumpster Near You Without Hidden Fees Or Late Delivery
          </h1>

          <!-- Infinite 7-Image Dumpster Slider Under Headline, paired with customer reviews -->
          <div class="hero-slider-wrapper" style="margin-bottom: 22px; overflow: hidden; position: relative; width: 100%;">
            <div class="hero-slider-track" id="heroSliderTrack" style="display: flex; transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1); width: 100%;">
              
              <!-- Slide 1 -->
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; flex-direction: column; background: #0f172a;">
                <img
                  src="/assets/images/dumpstersnow-real-1.webp"
                  alt="Dumpsters Now Driveway Delivery 1"
                  class="hero-slide-img"
                  style="border-radius: 14px; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; width: 100%; height: auto; max-height: 270px; object-fit: cover;"
                />
                <div class="hero-slide-review" style="background: #0f172a; padding: 16px 20px 20px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center;">
                  <div style="color: #f59e0b; font-size: 1rem; letter-spacing: 2px; margin-bottom: 8px;">★★★★★</div>
                  <p style="color: #e2e8f0; font-style: italic; font-size: 0.95rem; line-height: 1.5; margin: 0 0 8px;">"I appreciated the speed above everything: requested the dumpster Friday evening and it was dropped off Saturday afternoon. Smooth and efficient process."</p>
                  <div style="color: #94a3b8; font-weight: 700; font-size: 0.85rem;">Kocher Pharmacy</div>
                </div>
              </div>

              <!-- Slide 2 -->
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; flex-direction: column; background: #0f172a;">
                <img
                  src="/assets/images/dumpstersnow-real-2.webp"
                  alt="Dumpsters Now Roll-Off Dumpster Delivery 2"
                  class="hero-slide-img"
                  style="border-radius: 14px; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; width: 100%; height: auto; max-height: 270px; object-fit: cover;"
                />
                <div class="hero-slide-review" style="background: #0f172a; padding: 16px 20px 20px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center;">
                  <div style="color: #f59e0b; font-size: 1rem; letter-spacing: 2px; margin-bottom: 8px;">★★★★★</div>
                  <p style="color: #e2e8f0; font-style: italic; font-size: 0.95rem; line-height: 1.5; margin: 0 0 8px;">"Dumpster was delivered on time and removed when project was finished. Very flexible and great customer service. Driver was extremely polite."</p>
                  <div style="color: #94a3b8; font-weight: 700; font-size: 0.85rem;">Maymon Mustafa</div>
                </div>
              </div>

              <!-- Slide 3 -->
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; flex-direction: column; background: #0f172a;">
                <img
                  src="/assets/images/dumpstersnow-real-3.webp"
                  alt="Dumpsters Now Jobsite Roll-Off 3"
                  class="hero-slide-img"
                  style="border-radius: 14px; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; width: 100%; height: auto; max-height: 270px; object-fit: cover;"
                />
                <div class="hero-slide-review" style="background: #0f172a; padding: 16px 20px 20px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center;">
                  <div style="color: #f59e0b; font-size: 1rem; letter-spacing: 2px; margin-bottom: 8px;">★★★★★</div>
                  <p style="color: #e2e8f0; font-style: italic; font-size: 0.95rem; line-height: 1.5; margin: 0 0 8px;">"They were able to get a dumpster out when no one else was available. And left it for a few extra days no charge. Highly recommended!"</p>
                  <div style="color: #94a3b8; font-weight: 700; font-size: 0.85rem;">Nathan Hill</div>
                </div>
              </div>

              <!-- Slide 4 -->
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; flex-direction: column; background: #0f172a;">
                <img
                  src="/assets/images/dumpstersnow-real-4.webp"
                  alt="Dumpsters Now Clean Dumpster Rental 4"
                  class="hero-slide-img"
                  style="border-radius: 14px; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; width: 100%; height: auto; max-height: 270px; object-fit: cover;"
                />
                <div class="hero-slide-review" style="background: #0f172a; padding: 16px 20px 20px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center;">
                  <div style="color: #f59e0b; font-size: 1rem; letter-spacing: 2px; margin-bottom: 8px;">★★★★★</div>
                  <p style="color: #e2e8f0; font-style: italic; font-size: 0.95rem; line-height: 1.5; margin: 0 0 8px;">"Fantastic customer service. Rented two dumpsters over the past two years and both times have been great! Thank you Dumpsters Now!"</p>
                  <div style="color: #94a3b8; font-weight: 700; font-size: 0.85rem;">Brian Markovich</div>
                </div>
              </div>

              <!-- Slide 5 -->
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; flex-direction: column; background: #0f172a;">
                <img
                  src="/assets/images/dumpstersnow-real-5.webp"
                  alt="Dumpsters Now Driveway Safe Dumpster 5"
                  class="hero-slide-img"
                  style="border-radius: 14px; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; width: 100%; height: auto; max-height: 270px; object-fit: cover;"
                />
                <div class="hero-slide-review" style="background: #0f172a; padding: 16px 20px 20px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center;">
                  <div style="color: #f59e0b; font-size: 1rem; letter-spacing: 2px; margin-bottom: 8px;">★★★★★</div>
                  <p style="color: #e2e8f0; font-style: italic; font-size: 0.95rem; line-height: 1.5; margin: 0 0 8px;">"Super easy to book online and showed up right on time. Good communication on delivery and pick ups. Five stars!"</p>
                  <div style="color: #94a3b8; font-weight: 700; font-size: 0.85rem;">Rachel Steudle</div>
                </div>
              </div>

              <!-- Slide 6 -->
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; flex-direction: column; background: #0f172a;">
                <img
                  src="/assets/images/dumpstersnow-real-6.webp"
                  alt="Dumpsters Now Residential Dumpster 6"
                  class="hero-slide-img"
                  style="border-radius: 14px; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; width: 100%; height: auto; max-height: 270px; object-fit: cover;"
                />
                <div class="hero-slide-review" style="background: #0f172a; padding: 16px 20px 20px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center;">
                  <div style="color: #f59e0b; font-size: 1rem; letter-spacing: 2px; margin-bottom: 8px;">★★★★★</div>
                  <p style="color: #e2e8f0; font-style: italic; font-size: 0.95rem; line-height: 1.5; margin: 0 0 8px;">"Short notice delivery and short notice pickup was not a problem at all. Always reliable, prompt, and great service."</p>
                  <div style="color: #94a3b8; font-weight: 700; font-size: 0.85rem;">Dan Ribar</div>
                </div>
              </div>

              <!-- Slide 7 -->
              <div class="hero-slide" style="min-width: 100%; flex: 0 0 100%; display: flex; flex-direction: column; background: #0f172a;">
                <img
                  src="/assets/images/dumpstersnow-real-7.webp"
                  alt="Dumpsters Now Cleanout Dumpster 7"
                  class="hero-slide-img"
                  style="border-radius: 14px; border: 3.5px solid #000000; box-shadow: 6px 6px 0px #000000; width: 100%; height: auto; max-height: 270px; object-fit: cover;"
                />
                <div class="hero-slide-review" style="background: #0f172a; padding: 16px 20px 20px; text-align: center; flex: 1; display: flex; flex-direction: column; justify-content: center;">
                  <div style="color: #f59e0b; font-size: 1rem; letter-spacing: 2px; margin-bottom: 8px;">★★★★★</div>
                  <p style="color: #e2e8f0; font-style: italic; font-size: 0.95rem; line-height: 1.5; margin: 0 0 8px;">"I had a great experience with Dumpsters Now. They communicated well, booking was easy on the website, and prices were reasonable."</p>
                  <div style="color: #94a3b8; font-weight: 700; font-size: 0.85rem;">Chris Ollerich</div>
                </div>
              </div>

            </div>
          </div>

          <ul class="hero-features" style="margin-bottom: 30px; list-style: none; padding: 0;">
            <li>
              <div class="check-icon"><svg viewBox="0 0 512 512"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"/></svg></div>
              <div id="hero-delivery-bullet"><strong>Same-Day &amp; Next-Day Delivery</strong> Available across Metro Detroit</div>
            </li>
            <li>
              <div class="check-icon"><svg viewBox="0 0 512 512"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"/></svg></div>
              <div><strong>Flat-Rate Pricing</strong> — Drop-off, haul-away &amp; weight included</div>
            </li>
            <li>
              <div class="check-icon"><svg viewBox="0 0 512 512"><path d="M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z"/></svg></div>
              <div><strong>100% Driveway Protection Guarantee</strong> with rubber wheels</div>
            </li>
          </ul>
        </div>

        <!-- Right Hero Above-The-Fold Form -->
        <div class="quote-form-card" id="ppc-form">
          <h3>One Flat Price. No Hidden Fees. No Weight Surprises.</h3>
          <p id="hero-form-subtext">Lock in your flat-rate delivery date. Same-day &amp; next-day dispatch available across Wayne, Oakland, and Macomb counties.</p>

          <form id="ppcQuoteForm">
            <!-- Invisible Honeypot Anti-Spam Field -->
            <div style="display:none !important; visibility:hidden !important; position:absolute; left:-9999px;" aria-hidden="true">
              <input type="text" name="website_hp_check" tabindex="-1" autocomplete="off">
            </div>
            <div class="form-group">
              <label class="form-label" for="nameHero">Your Name <span>*</span></label>
              <input type="text" id="nameHero" class="form-input" required placeholder="John Doe">
            </div>

            <div class="form-group">
              <label class="form-label" for="phoneHero">Phone Number <span>*</span></label>
              <input type="tel" id="phoneHero" class="form-input" required placeholder="(888) 870-9906">
            </div>

            <div class="form-group">
              <label class="form-label" for="cityHero">City <span>*</span></label>
              <input type="text" id="cityHero" name="city" class="form-input" required placeholder="e.g. Detroit, Livonia, Canton">
            </div>

            <div class="form-group">
              <label class="form-label">What size dumpster do you need? <span>*</span></label>
              <div class="radio-group">
                <div class="radio-btn-option">
                  <input type="radio" id="size15Hero" name="dumpster_size_hero" value="15 Yard" required>
                  <label for="size15Hero">15 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="size20Hero" name="dumpster_size_hero" value="20 Yard">
                  <label for="size20Hero">20 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="size30Hero" name="dumpster_size_hero" value="30 Yard">
                  <label for="size30Hero">30 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="size40Hero" name="dumpster_size_hero" value="40 Yard">
                  <label for="size40Hero">40 Yard</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="sizeNotsureHero" name="dumpster_size_hero" value="Not Sure">
                  <label for="sizeNotsureHero">Not sure</label>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">How soon do you need the dumpster? <span>*</span></label>
              <div class="radio-group">
                <div class="radio-btn-option">
                  <input type="radio" id="timeTodayHero" name="how_soon_hero" value="Today" required>
                  <label for="timeTodayHero">Today</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="time3DaysHero" name="how_soon_hero" value="Within 3 days">
                  <label for="time3DaysHero">Within 3 days</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="timeWeekHero" name="how_soon_hero" value="Within a week">
                  <label for="timeWeekHero">Within a week</label>
                </div>
                <div class="radio-btn-option">
                  <input type="radio" id="timeLaterHero" name="how_soon_hero" value="Much later">
                  <label for="timeLaterHero">Much later</label>
                </div>
              </div>
            </div>

            <!-- Cloudflare Turnstile Anti-Spam Widget -->
            <div class="cf-turnstile" data-sitekey="0x4AAAAAAERzCayg0G9M4fKH" data-theme="light" data-appearance="interaction-only" style="margin-top:20px; display:flex; justify-content:center;"></div>

            <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:20px; font-size:1rem;">
              Get Your Dumpster Rental Quote
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== PPC TRUST BADGE STRIP ==================== -->
  <div class="ppc-trust-bar">
    <div class="container">
      <div class="ppc-trust-grid">
        <div class="ppc-trust-item">
          <svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>
          No Hidden Surcharges
        </div>
        <div class="ppc-trust-item">
          <svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>
          Driveway Safe Wheels
        </div>
        <div class="ppc-trust-item">
          <svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>
          On-Time Guaranteed
        </div>
        <div class="ppc-trust-item">
          <svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>
          5.0 Rating (120+ Google Reviews)
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== ONLINE BOOKING EMBED SECTION ==================== -->
  <section class="pricing-section" id="pricing-grid" style="padding: 60px 0 80px; background-color: var(--bg-cream);">
    <div class="container" style="max-width: 1240px; margin: 0 auto;">
      <div class="section-header" style="text-align: center; margin-bottom: 35px;">
        <div class="section-subtitle">Instant Online Checkout</div>
        <h2 class="section-title">Rent Your Dumpster Online In Seconds</h2>
        <p style="font-size:1.05rem; color:#475569; max-width:700px; margin:12px auto 0;">
          Select your dumpster size, pick your delivery date, and lock in your flat rate instantly.
        </p>
      </div>

      <div style="background: #ffffff; border: 3.5px solid #000000; box-shadow: 8px 8px 0px #000000; border-radius: 12px; overflow: hidden; padding: 15px;">
        <div class="survcart-embed-presenter" id="y24Fkl9aMh2O1ALa6ZgY" style="width: 100%; min-height: 980px;">
          <iframe src="https://embed.survcart.com?type=landing&co=N7QRWW7M9sYkyT9vzsV6&wsid=dx9QtVymTA667zSWZvVW&sel=y24Fkl9aMh2O1ALa6ZgY" style="width: 100%; height: 980px; border: none; display: block;" title="Online Dumpster Rental Booking"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIALS SLIDER ==================== -->
  <TestimonialSlider />

  <!-- ==================== PHOTO GALLERY & VIDEO ==================== -->
  <section class="seo-section-cream">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Real Equipment In Action</div>
        <h2 class="section-title">See Our Fleet Deliveries Across Metro Detroit</h2>
      </div>

      <div class="photo-gallery-grid">
        <div class="gallery-card">
          <img src="/assets/images/20230605_104913.webp" alt="Dumpsters Now Heavy Duty Orange Dumpster On Site" loading="lazy" decoding="async">
          <div class="gallery-card-body">Heavy-Duty Roll-Off Delivery</div>
        </div>
        <div class="gallery-card">
          <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.53.00 PM.jpeg" alt="Dumpsters Now Residential Driveway Delivery Truck" loading="lazy" decoding="async">
          <div class="gallery-card-body">Driveway Protection Rubber Wheels</div>
        </div>
        <div class="gallery-card">
          <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.53.15 PM.jpeg" alt="Dumpsters Now Job Site Waste Swap-Out" loading="lazy" decoding="async">
          <div class="gallery-card-body">Same-Day Job Site Swap-Outs</div>
        </div>
      </div>

