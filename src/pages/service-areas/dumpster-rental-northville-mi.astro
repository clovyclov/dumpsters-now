---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteFormSection from '../../components/QuoteFormSection.astro';

const faqSchema = [
  {
    "question": "How quickly can I get a dumpster delivered in Northville?",
    "answer": "Because our main depot is at 7374 Chubb Rd in Northville, we offer immediate priority dispatch! Same-day delivery is available within 2 hours of calling (888) 870-9906."
  },
  {
    "question": "Do I need a permit for a dumpster on my driveway in Northville Township?",
    "answer": "No. Driveway placement on private property in Northville Township does not require a permit. If placing on a public street in City of Northville, a DPW right-of-way permit is required."
  }
];
---

<BaseLayout
  title="Northville MI Dumpster Rental | Same-Day Delivery from Chubb Rd Hub"
  description="Dumpster rental in Northville & Northville Twp, MI. Direct from our 7374 Chubb Rd depot. Fast 15-40 yard roll-off dumpsters with driveway protection. Call 888-870-9906."
  canonical="https://dumpstersnow.com/service-areas/dumpster-rental-northville-mi/"
  activePage="services"
  faqSchema={faqSchema}
  breadcrumbName="Northville Dumpster Rental"
>
  <section class="hero-section" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 100px 0 135px; color: white;">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="rating-badge">
          <div class="stars">★★★★★</div>
          <span class="rating-text">LOCAL NORTHVILLE DISPATCH | 0–5 Miles (Immediate Dispatch)</span>
        </div>
        <h1 class="hero-title" style="color: white; font-size: 2.5rem;">
          Roll-Off Dumpster Rental in Northville, MI
        </h1>
        <p style="font-size: 1.1rem; color: #cbd5e1; margin-bottom: 20px; line-height: 1.6;">
          Dumpsters Now operates directly out of our primary dispatch hub at 7374 Chubb Rd in Northville. Because our fleet is headquartered right here in Northville, we offer the fastest turnaround times in the region — often delivering your roll-off dumpster in under 2 hours.
        </p>
        <ul class="hero-features">
          <li>
            <div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"></path></svg></div>
            <div>Dispatched from local Chubb Rd depot</div>
          </li>
          <li>
            <div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"></path></svg></div>
            <div>100% Driveway protection for Northville homes</div>
          </li>
          <li>
            <div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"></path></svg></div>
            <div>Flat-rate pricing with zero hidden fees</div>
          </li>
        </ul>
        <div class="hero-cta-buttons" style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 25px;">
          <a href="/book-now/" class="btn btn-green" style="font-size: 1.05rem;">Book Northville Dumpster Online</a>
          <a href="tel:888-870-9906" class="btn btn-red" style="font-size: 1.05rem;">Call (888) 870-9906</a>
        </div>
      </div>
      <div class="hero-image-wrapper">
        <img src="/assets/images/20230605_104913.webp" alt="Dumpsters Now roll-off dumpster delivery in Northville MI" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- Localized Neighborhoods & Permit Info -->
  <section style="padding: 50px 0; background: white;">
    <div class="container" style="max-width: 1000px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
        <div style="background: var(--bg-light); border-radius: 12px; padding: 28px; border: 1px solid #e2e8f0;">
          <h3 style="color: var(--navy-dark); font-size: 1.3rem; margin-bottom: 12px; font-weight: 800;">Northville Service Coverage</h3>
          <p style="color: var(--text-dark); line-height: 1.6; font-size: 0.95rem;">
            <strong>Areas Served:</strong> Downtown Historic Northville, Northville Township, Historic District (Main & Center Streets), Six Mile & Seven Mile Corridors, Maybury State Park Vicinity.
          </p>
          <p style="color: var(--text-muted); margin-top: 10px; font-size: 0.88rem;">
            <strong>Hub Distance:</strong> 0–5 Miles (Immediate Dispatch)
          </p>
        </div>

        <div style="background: var(--bg-light); border-radius: 12px; padding: 28px; border: 1px solid #e2e8f0;">
          <h3 style="color: var(--navy-dark); font-size: 1.3rem; margin-bottom: 12px; font-weight: 800;">Northville Dumpster Permit Rules</h3>
          <p style="color: var(--text-dark); line-height: 1.6; font-size: 0.95rem;">
            Placing a roll-off dumpster on private residential driveways in Northville Township requires zero city permits. If you need to place a dumpster on public streets or right-of-way within the City of Northville limits, a Right-of-Way permit from the Northville Department of Public Works (DPW) is required. Our local drivers take extra care on historic brick & paved driveways by placing protective wood skids beneath every container wheel.
          </p>
        </div>
      </div>

      <div style="margin-top: 35px; background: #f8fafc; border-radius: 12px; padding: 25px; border: 1px solid #e2e8f0; text-align: center;">
        <h4 style="color: var(--navy-dark); font-weight: 800; font-size: 1.15rem; margin-bottom: 8px;">Recommended Dumpster Sizes for Northville:</h4>
        <p style="color: var(--text-dark); margin: 0; font-size: 1rem;">15-Yard for historic home attic & garage cleanouts; 20-Yard & 30-Yard for colonial kitchen remodels & shingle tear-offs.</p>
      </div>
    </div>
  </section>

  <!-- Pricing Cards Grid -->
  <section class="pricing-section" id="pricing" style="background: var(--bg-light);">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Transparent Flat Rates</div>
        <h2 class="section-title">Northville, MI Dumpster Rental Pricing</h2>
      </div>

      <div class="pricing-grid">
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$375</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.webp" alt="15 Yard Roll Off Dumpster in Northville MI" loading="lazy" decoding="async">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Garage & basement cleanouts</li>
              <li>Small bathroom remodels</li>
              <li>Yard waste & branch clearing</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 15-Yard →</a>
          </div>
        </div>

        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$425</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.webp" alt="20 Yard Roll Off Dumpster in Northville MI" loading="lazy" decoding="async">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Kitchen remodels & floor removal</li>
              <li>Roofing tear-offs (up to 30 sq)</li>
              <li>Multi-room deck & estate purges</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 20-Yard →</a>
          </div>
        </div>

        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$465</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.webp" alt="30 Yard Roll Off Dumpster in Northville MI" loading="lazy" decoding="async">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Whole-house additions & renovations</li>
              <li>Major estate cleanouts</li>
              <li>Holds up to 12 truck loads</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 30-Yard →</a>
          </div>
        </div>

        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">40 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$550</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.webp" alt="40 Yard Roll Off Dumpster in Northville MI" loading="lazy" decoding="async">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Commercial construction & teardowns</li>
              <li>Industrial warehouse overhauls</li>
              <li>Holds up to 16 truck loads</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 40-Yard →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 1: Image Left, Content Right -->
  <section style="padding: 60px 0; background: white;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dumpstersnow-real-1.webp" alt="Dumpsters Now roll-off dumpster delivered in Northville MI" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
        <div>
          <div class="section-subtitle">Local Northville Fleet Depot</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Fast 2-Hour Dispatch From 7374 Chubb Road</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Because Dumpsters Now is headquartered right here at 7374 Chubb Rd in Northville, we deliver faster than any regional broker or call center. When you call us for a residential or commercial dumpster in Northville, your container is dispatched directly from our local yard.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Priority same-day & next-day drop-off guaranteed</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Direct local phone support — speak directly with our Northville dispatch team</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> 100% transparent flat-rate pricing with zero hidden fees</li>
          </ul>
          <a href="tel:888-870-9906" class="btn btn-red">Call Northville Hub: (888) 870-9906</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 2: Content Left, Image Right -->
  <section style="padding: 60px 0; background: var(--bg-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div>
          <div class="section-subtitle">Property Care & Protection</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Driveway Protection For Historic & Suburban Northville Homes</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Whether your project is located in Historic Downtown Northville with delicate brick pavers or a suburban Northville Township subdivision with custom stamped concrete, our heavy-duty roll-off containers are delivered with extreme care.
          </p>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 25px;">
            Our drivers place heavy protective wooden skids beneath every container wheel before lowering the container onto your property, ensuring zero scuffs, scratches, or surface damage.
          </p>
          <a href="/book-now/" class="btn btn-green">Reserve Your Dumpster Online →</a>
        </div>
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/20230605_104913.webp" alt="Roll off dumpster placement in Northville MI" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
      </div>
    </div>
  </section>

  <!-- Local FAQs -->
  <section class="faq-section" style="padding: 60px 0; background: white;">
    <div class="container" style="max-width: 900px;">
      <div class="section-header">
        <h2 class="section-title">Northville, MI Dumpster Rental FAQs</h2>
      </div>
      <div class="faq-grid" style="grid-template-columns: 1fr;">
          <div class="faq-item">
            <button class="faq-question">
              <span>How quickly can I get a dumpster delivered in Northville?</span>
              <svg class="faq-icon" viewBox="0 0 32 32"><path d="M16.609 22.389c-0.37 0.37-0.97 0.37-1.34 0l-9.659-9.659c-0.37-0.37-0.37-0.97 0-1.34l0.447-0.447c0.37-0.37 0.97-0.37 1.34 0l8.542 8.542 8.542-8.542c0.37-0.37 0.97-0.37 1.34 0l0.447 0.447c0.37 0.37 0.37 0.97 0 1.34l-9.659 9.659z"/></svg>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                Because our main depot is at 7374 Chubb Rd in Northville, we offer immediate priority dispatch! Same-day delivery is available within 2 hours of calling (888) 870-9906.
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question">
              <span>Do I need a permit for a dumpster on my driveway in Northville Township?</span>
              <svg class="faq-icon" viewBox="0 0 32 32"><path d="M16.609 22.389c-0.37 0.37-0.97 0.37-1.34 0l-9.659-9.659c-0.37-0.37-0.37-0.97 0-1.34l0.447-0.447c0.37-0.37 0.97-0.37 1.34 0l8.542 8.542 8.542-8.542c0.37-0.37 0.97-0.37 1.34 0l0.447 0.447c0.37 0.37 0.37 0.97 0 1.34l-9.659 9.659z"/></svg>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                No. Driveway placement on private property in Northville Township does not require a permit. If placing on a public street in City of Northville, a DPW right-of-way permit is required.
              </div>
            </div>
          </div>
      </div>
    </div>
  </section>

  <!-- Complete Sitewide Quote Form Component -->
  <QuoteFormSection
    cityName="Northville"
    subtitle="NEED A DUMPSTER IN NORTHVILLE?"
    title="GET FAST LOCAL DELIVERY TODAY"
    description="Lock in your flat-rate dumpster price with zero weight surprises and driveway-safe delivery across Northville, MI."
    defaultCity="Northville"
  />
</BaseLayout>
