---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteFormSection from '../../components/QuoteFormSection.astro';

const faqSchema = [
  {
    "question": "What is the most popular dumpster size in Livonia?",
    "answer": "The 20-yard roll-off dumpster is our #1 seller in Livonia. It holds 8 pickup truck loads of debris \u2014 perfect for kitchen remodels, roof tear-offs, and garage cleanouts."
  },
  {
    "question": "Can I put heavy concrete or brick in a Livonia dumpster?",
    "answer": "Yes! Heavy inert materials like concrete, brick, dirt, and asphalt can be loaded into our 15-yard and 20-yard heavy-spec dumpsters up to DOT weight limits."
  }
];
---

<BaseLayout
  title="Livonia MI Dumpster Rental | Commercial & Residential Roll-Off Containers"
  description="Dumpster rental in Livonia, MI. Heavy-duty 15 to 40-yard roll off dumpsters for home remodels, roofing & industrial cleanouts. Call 888-870-9906."
  canonical="https://dumpstersnow.com/service-areas/dumpster-rental-livonia-mi/"
  activePage="services"
  faqSchema={faqSchema}
  breadcrumbName="Livonia Dumpster Rental"
>
  <section class="hero-section" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 100px 0 135px; color: white;">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="rating-badge">
          <div class="stars">★★★★★</div>
          <span class="rating-text">LOCAL LIVONIA DISPATCH | 8–12 Miles (20-Min Dispatch)</span>
        </div>
        <h1 class="hero-title" style="color: white; font-size: 2.5rem;">
          Roll-Off Dumpster Rental in Livonia, MI
        </h1>
        <p style="font-size: 1.1rem; color: #cbd5e1; margin-bottom: 20px; line-height: 1.6;">
          Dumpsters Now provides fast, affordable roll-off dumpster rentals throughout Livonia, MI. From residential ranch home remodels along Five Mile to commercial warehouse build-outs in the Schoolcraft industrial corridor, we deliver heavy-duty containers with zero hidden weight fees.
        </p>
        <ul class="hero-features">
          <li>
            <div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"></path></svg></div>
            <div>Dispatched from local Chubb Rd depot</div>
          </li>
          <li>
            <div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"></path></svg></div>
            <div>100% Driveway protection for Livonia homes</div>
          </li>
          <li>
            <div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"></path></svg></div>
            <div>Flat-rate pricing with zero hidden fees</div>
          </li>
        </ul>
        <div class="hero-cta-buttons" style="display: flex; gap: 15px; flex-wrap: wrap; margin-top: 25px;">
          <a href="/book-now/" class="btn btn-green" style="font-size: 1.05rem;">Book Livonia Dumpster Online</a>
          <a href="tel:888-870-9906" class="btn btn-red" style="font-size: 1.05rem;">Call (888) 870-9906</a>
        </div>
      </div>
      <div class="hero-image-wrapper">
        <img src="/assets/images/20230605_104913.jpg" alt="Dumpsters Now roll-off dumpster delivery in Livonia MI">
      </div>
    </div>
  </section>

  <!-- Localized Neighborhoods & Permit Info -->
  <section style="padding: 50px 0; background: white;">
    <div class="container" style="max-width: 1000px;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px;">
        <div style="background: var(--bg-light); border-radius: 12px; padding: 28px; border: 1px solid #e2e8f0;">
          <h3 style="color: var(--navy-dark); font-size: 1.3rem; margin-bottom: 12px; font-weight: 800;">Livonia Service Coverage</h3>
          <p style="color: var(--text-dark); line-height: 1.6; font-size: 0.95rem;">
            <strong>Areas Served:</strong> Five Mile, Six Mile & Seven Mile Subdivisions, Schoolcraft Industrial Park, Greenmead Historic Area, Newburgh & Farmington Road Corridors.
          </p>
          <p style="color: var(--text-muted); margin-top: 10px; font-size: 0.88rem;">
            <strong>Hub Distance:</strong> 8–12 Miles (20-Min Dispatch)
          </p>
        </div>

        <div style="background: var(--bg-light); border-radius: 12px; padding: 28px; border: 1px solid #e2e8f0;">
          <h3 style="color: var(--navy-dark); font-size: 1.3rem; margin-bottom: 12px; font-weight: 800;">Livonia Dumpster Placement & Ordinance Rules</h3>
          <p style="color: var(--text-dark); line-height: 1.6; font-size: 0.95rem;">
            The City of Livonia Building Department permits residential driveway dumpster placement for up to 14 days without a special permit. If placing a container on a commercial job site or public road, safety reflectors and proper setback clearances must be maintained according to Livonia DPW specifications.
          </p>
        </div>
      </div>

      <div style="margin-top: 35px; background: #f8fafc; border-radius: 12px; padding: 25px; border: 1px solid #e2e8f0; text-align: center;">
        <h4 style="color: var(--navy-dark); font-weight: 800; font-size: 1.15rem; margin-bottom: 8px;">Recommended Dumpster Sizes for Livonia:</h4>
        <p style="color: var(--text-dark); margin: 0; font-size: 1rem;">20-Yard & 30-Yard for residential remodels & roof tear-offs; 40-Yard for commercial demolition along I-96.</p>
      </div>
    </div>
  </section>

  <!-- Pricing Cards Grid -->
  <section class="pricing-section" id="pricing" style="background: var(--bg-light);">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Transparent Flat Rates</div>
        <h2 class="section-title">Livonia, MI Dumpster Rental Pricing</h2>
      </div>

      <div class="pricing-grid">
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$375</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.png" alt="15 Yard Roll Off Dumpster in Livonia MI">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Garage & basement cleanouts</li>
              <li>Small bathroom remodels</li>
              <li>Yard waste & branch clearing</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 15-Yard →</a>
          </div>
        </div>

        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$425</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.png" alt="20 Yard Roll Off Dumpster in Livonia MI">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Kitchen remodels & floor removal</li>
              <li>Roofing tear-offs (up to 30 sq)</li>
              <li>Multi-room deck & estate purges</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 20-Yard →</a>
          </div>
        </div>

        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$465</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.png" alt="30 Yard Roll Off Dumpster in Livonia MI">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Whole-house additions & renovations</li>
              <li>Major estate cleanouts</li>
              <li>Holds up to 12 truck loads</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 30-Yard →</a>
          </div>
        </div>

        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">40 Yard Dumpster</h3>
            <div class="price-box">
              <span class="price-label">Starting At</span>
              <span class="price-value">$550</span>
            </div>
          </div>
          <div class="pricing-card-img">
            <img src="/assets/images/dumpster-card-product.png" alt="40 Yard Roll Off Dumpster in Livonia MI">
          </div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li>Commercial construction & teardowns</li>
              <li>Industrial warehouse overhauls</li>
              <li>Holds up to 16 truck loads</li>
            </ul>
            <a href="/book-now/" class="btn btn-green btn-block">Reserve 40-Yard →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 1: Image Left, Content Right -->
  <section style="padding: 60px 0; background: white;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dumpstersnow-real-4.jpg" alt="Dumpsters Now roll-off dumpster delivered in Livonia MI" style="width: 100%; height: auto; display: block; object-fit: cover;">
        </div>
        <div>
          <div class="section-subtitle">Residential & Commercial Heavy-Spec Containers</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Built for Livonia Roof Tear-Offs & Remodels</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Our heavy-duty steel roll-off dumpsters handle tough construction debris including asphalt shingles, concrete, lumber, and drywall. Serving Livonia homeowners along 5 Mile, 6 Mile, and 7 Mile roads.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Heavy-spec steel containers equipped with easy walk-in rear doors</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Generous weight allowances tailored for roofing and renovation waste</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Same-day commercial roll-off drop-off along the I-96 corridor</li>
          </ul>
          <a href="/book-now/" class="btn btn-red">Reserve Livonia Dumpster Online →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 2: Content Left, Image Right -->
  <section style="padding: 60px 0; background: var(--bg-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div>
          <div class="section-subtitle">Transparent Flat Pricing</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Zero Weight Surprises & Livonia Building Dept Compliance</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            We keep dumpster rental straightforward in Livonia. Your flat-rate quote covers delivery, pickup, generous weight allowance, driveway protection, and 7 days on site.
          </p>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 25px;">
            Our experienced drivers ensure proper driveway positioning complying with Livonia municipal 14-day residential placement guidelines.
          </p>
          <a href="/book-now/" class="btn btn-green">Reserve Your Dumpster Online →</a>
        </div>
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dumpstersnow-real-5.jpg" alt="Roll off dumpster placement in Livonia MI" style="width: 100%; height: auto; display: block; object-fit: cover;">
        </div>
      </div>
    </div>
  </section>

  <!-- Local FAQs -->
  <section class="faq-section" style="padding: 60px 0; background: white;">
    <div class="container" style="max-width: 900px;">
      <div class="section-header">
        <h2 class="section-title">Livonia, MI Dumpster Rental FAQs</h2>
      </div>
      <div class="faq-grid" style="grid-template-columns: 1fr;">
          <div class="faq-item">
            <button class="faq-question">
              <span>What is the most popular dumpster size in Livonia?</span>
              <svg class="faq-icon" viewBox="0 0 32 32"><path d="M16.609 22.389c-0.37 0.37-0.97 0.37-1.34 0l-9.659-9.659c-0.37-0.37-0.37-0.97 0-1.34l0.447-0.447c0.37-0.37 0.97-0.37 1.34 0l8.542 8.542 8.542-8.542c0.37-0.37 0.97-0.37 1.34 0l0.447 0.447c0.37 0.37 0.37 0.97 0 1.34l-9.659 9.659z"/></svg>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                The 20-yard roll-off dumpster is our #1 seller in Livonia. It holds 8 pickup truck loads of debris — perfect for kitchen remodels, roof tear-offs, and garage cleanouts.
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question">
              <span>Can I put heavy concrete or brick in a Livonia dumpster?</span>
              <svg class="faq-icon" viewBox="0 0 32 32"><path d="M16.609 22.389c-0.37 0.37-0.97 0.37-1.34 0l-9.659-9.659c-0.37-0.37-0.37-0.97 0-1.34l0.447-0.447c0.37-0.37 0.97-0.37 1.34 0l8.542 8.542 8.542-8.542c0.37-0.37 0.97-0.37 1.34 0l0.447 0.447c0.37 0.37 0.37 0.97 0 1.34l-9.659 9.659z"/></svg>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                Yes! Heavy inert materials like concrete, brick, dirt, and asphalt can be loaded into our 15-yard and 20-yard heavy-spec dumpsters up to DOT weight limits.
              </div>
            </div>
          </div>
      </div>
    </div>
  </section>

  <!-- Complete Sitewide Quote Form Component -->
  <QuoteFormSection
    cityName="Livonia"
    subtitle="NEED A DUMPSTER IN LIVONIA?"
    title="GET FAST LOCAL DELIVERY TODAY"
    description="Lock in your flat-rate dumpster price with zero weight surprises and driveway-safe delivery across Livonia, MI."
    defaultCity="Livonia"
  />
</BaseLayout>
