import pricingData from '../../data/pricing.json';
---

<BaseLayout
  title="Dumpster Rental Prices & Sizes Metro Detroit | Dumpsters Now"
  description="Compare roll-off dumpster sizes (15, 20, 30, 40 yard) and transparent flat-rate prices in Metro Detroit. No weight surprises. Call 888-870-9906!"
  canonical="https://dumpstersnow.com/pricing-and-sizes/"
  activePage="pricing"
>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="banner-pill">Transparent Flat-Rate Pricing</span>

        <h1 class="hero-title">
          Dumpster Rental Prices & Sizes In Metro Detroit
        </h1>

        <p style="font-size:1.15rem; color:#e2e8f0; margin-bottom:25px;">
          Select from our 15, 20, 30, and 40-yard roll-off containers with all-inclusive flat rates. Delivery, haul-away, and weight limits are clearly included up front.
        </p>

        <ul class="hero-features">
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>All-inclusive pricing (Delivery, Pickup & Tonnage)</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Flexible 7-day standard rental periods</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Same-day & next-day delivery guaranteed</li>
        </ul>

        <a href="/book-now/" class="btn btn-red">Lock In Your Price Now</a>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/20230605_104913.webp" alt="Dumpsters Now Roll Off Dumpster Delivery Fleet" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- ==================== REUSABLE ESTIMATOR SECTION ==================== -->
  <DumpsterSizeCalculator isSection={true} />

  <!-- ==================== PRICING / SIZES SECTION ==================== -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Dumpster Rental Sizes</div>
        <h2 class="section-title">Select Your Container Size</h2>
      </div>

      <div class="pricing-grid">
        {pricingData.sizes.map((item) => (
          <div class={`pricing-card ${item.popular ? 'popular-card' : ''}`}>
            {item.popular && <div class="popular-badge">Most Popular</div>}
            <div class="pricing-card-header">
              <h3 class="dumpster-size-title">{item.name}</h3>
              <div class="price-box">
                <span class="price-label">Starting At</span>
                <span class="price-value">{item.formattedPrice}</span>
              </div>
            </div>
            <div class="pricing-card-img">
              <img src={item.image} alt={item.name} loading="lazy" decoding="async">
            </div>
            <div class="pricing-card-body">
              <div class="best-used-heading">Best Used For:</div>
              <ul class="pricing-card-features">
                {item.bestFor.map((feature) => (
                  <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>{feature}</li>
                ))}
              </ul>
            </div>
            <div class="pricing-card-footer">
              <a href="/book-now/" class={`btn ${item.popular ? 'btn-red' : 'btn-outline'} btn-block`}>Reserve This Size</a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== DETAILED SIZING & TRUCK LOAD CAPACITY TABLE ==================== -->
  <section class="seo-section-cream">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Capacity & Volume Guide</div>
        <h2 class="section-title">Roll-Off Container Sizing & Capacity Comparison</h2>
        <p style="font-size:1.05rem; color:#475569; max-width:800px; margin:15px auto 0;">
          Eliminate the guesswork. Use our Metro Detroit dumpster capacity matrix to compare dimensions, pickup truck load equivalents, and weight allowances for your job.
        </p>
      </div>

      <div class="seo-table-wrapper">
        <table class="seo-table">
          <thead>
            <tr>
              <th>Dumpster Size</th>
              <th>Dimensions (L × W × H)</th>
              <th>Pickup Truck Capacity</th>
              <th>Weight Limit</th>
              <th>Best Project Uses</th>
            </tr>
          </thead>
          <tbody>
            {pricingData.sizes.map((item) => (
              <tr>
                <td><strong>{item.name}</strong></td>
                <td>{item.dimensions}</td>
                <td>{item.truckLoads}</td>
                <td>{item.weightAllowance}</td>
                <td>{item.bestFor.join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ==================== ALLOWED VS PROHIBITED MATERIALS ==================== -->
  <section class="seo-section">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Disposal Guidelines</div>
        <h2 class="section-title">Accepted vs. Prohibited Debris Materials</h2>
        <p style="font-size:1.05rem; color:#475569; max-width:800px; margin:15px auto 0;">
          To ensure smooth disposal at local Michigan landfills, review our list of allowed household and construction materials.
        </p>
      </div>

      <div class="allowed-prohibited-grid">
        <div class="allowed-box">
          <h3>✔ Allowed Waste Materials</h3>
          <ul class="allowed-list">
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg> Household furniture, mattresses & appliances</li>
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg> Drywall, framing lumber, flooring & cabinetry</li>
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg> Roofing shingles, tile, siding & masonry</li>
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg> Yard waste, tree branches, sod & bushes</li>
          </ul>
        </div>

        <div class="prohibited-box">
          <h3>✖ Prohibited Materials</h3>
          <ul class="prohibited-list">
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m101.82 252.828l-22.627 22.627c-4.686 4.686-12.284 4.686-16.971 0L256 272.971l-62.222 62.222c-4.686 4.686-12.284 4.686-16.971 0l-22.627-22.627c-4.686-4.686-4.686-12.284 0-16.971L216.404 256l-62.222-62.222c-4.686-4.686-4.686-12.284 0-16.971l22.627-22.627c4.686-4.686 12.284-4.686 16.971 0L256 239.029l62.222-62.222c4.686-4.686 12.284-4.686 16.971 0l22.627 22.627c4.686 4.686 4.686 12.284 0 16.971L295.596 256l62.222 62.222c4.687 4.686 4.687 12.284.002 16.971z"/></svg> Liquid paint, solvents & toxic chemicals</li>
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m101.82 252.828l-22.627 22.627c-4.686 4.686-12.284 4.686-16.971 0L256 272.971l-62.222 62.222c-4.686 4.686-12.284 4.686-16.971 0l-22.627-22.627c-4.686-4.686-4.686-12.284 0-16.971L216.404 256l-62.222-62.222c-4.686-4.686-4.686-12.284 0-16.971l22.627-22.627c4.686-4.686 12.284-4.686 16.971 0L256 239.029l62.222-62.222c4.686-4.686 12.284-4.686 16.971 0l22.627 22.627c4.686 4.686 4.686 12.284 0 16.971L295.596 256l62.222 62.222c4.687 4.686 4.687 12.284.002 16.971z"/></svg> Car batteries, motor oil & gasoline</li>
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m101.82 252.828l-22.627 22.627c-4.686 4.686-12.284 4.686-16.971 0L256 272.971l-62.222 62.222c-4.686 4.686-12.284 4.686-16.971 0l-22.627-22.627c-4.686-4.686-4.686-12.284 0-16.971L216.404 256l-62.222-62.222c-4.686-4.686-4.686-12.284 0-16.971l22.627-22.627c4.686-4.686 12.284-4.686 16.971 0L256 239.029l62.222-62.222c4.686-4.686 12.284-4.686 16.971 0l22.627 22.627c4.686 4.686 4.686 12.284 0 16.971L295.596 256l62.222 62.222c4.687 4.686 4.687 12.284.002 16.971z"/></svg> Asbestos & biohazardous waste</li>
            <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m101.82 252.828l-22.627 22.627c-4.686 4.686-12.284 4.686-16.971 0L256 272.971l-62.222 62.222c-4.686 4.686-12.284 4.686-16.971 0l-22.627-22.627c-4.686-4.686-4.686-12.284 0-16.971L216.404 256l-62.222-62.222c-4.686-4.686-4.686-12.284 0-16.971l22.627-22.627c4.686-4.686 12.284-4.686 16.971 0L256 239.029l62.222-62.222c4.686-4.686 12.284-4.686 16.971 0l22.627 22.627c4.686 4.686 4.686 12.284 0 16.971L295.596 256l62.222 62.222c4.687 4.686 4.687 12.284.002 16.971z"/></svg> Propane tanks & pressurized cylinders</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== REAL EQUIPMENT & DELIVERY SHOWCASE ==================== -->
  <section class="seo-section-cream">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Real Equipment In Action</div>
        <h2 class="section-title">See Our Local Fleet & Job Site Deliveries</h2>
      </div>

      <div class="photo-gallery-grid">
        <div class="gallery-card">
          <img src="/assets/images/20230605_104913.webp" alt="Dumpsters Now Heavy Duty Orange Dumpster On Site" loading="lazy" decoding="async">
          <div class="gallery-card-body">Heavy-Duty Roll-Off Delivery</div>
        </div>
        <div class="gallery-card">
          <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.53.00 PM.jpeg" alt="Dumpsters Now Residential Driveway Delivery Truck" loading="lazy" decoding="async">
          <div class="gallery-card-body">Driveway Protection Rubber Wheels</div>
        </div>
        <div class="gallery-card">
          <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.53.15 PM.jpeg" alt="Dumpsters Now Job Site Waste Swap-Out" loading="lazy" decoding="async">
          <div class="gallery-card-body">Same-Day Job Site Swap-Outs</div>
        </div>
      </div>

      <!-- Real Delivery Video -->
      <div class="video-showcase-container">
        <video controls poster="/assets/images/20230605_104913.webp" preload="metadata" style="width: 100%; border-radius: 12px; aspect-ratio: 16 / 9; object-fit: cover; background: #000;">
          <source src="/assets/videos/VID-20260803-WA0006.mp4" type="video/mp4">
          Your browser does not support HTML5 video.
        </video>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIALS SECTION ==================== -->
  <TestimonialSlider />

  <!-- ==================== QUOTE FORM SECTION ==================== -->
  <section class="quote-section" id="get-started">
    <div class="container quote-grid">
      <div class="quote-info">
        <div class="section-subtitle">Get Started Today</div>
        <h2 class="section-title">Lock In Your Dumpster Rental Rate</h2>
        <p class="quote-desc">Complete the form below or call (888) 870-9906 to schedule your delivery date.</p>
      </div>

      <div class="quote-form-card">
        <form id="quoteForm">
          <div class="form-group"><label class="form-label" for="name">Your Name <span>*</span></label><input type="text" id="name" class="form-input" required placeholder="John Doe"></div>
          <div class="form-group"><label class="form-label" for="email">Your Email <span>*</span></label><input type="email" id="email" class="form-input" required placeholder="john@example.com"></div>
          <div class="form-group"><label class="form-label" for="phone">Phone Number <span>*</span></label><input type="tel" id="phone" class="form-input" required placeholder="(888) 870-9906"></div>
          <div class="form-group"><label class="form-label" for="city">City <span>*</span></label><input type="text" id="city" name="city" class="form-input" required placeholder="e.g. Detroit, Livonia, Canton"></div>
          <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:25px;">Get Flat-Rate Dumpster Quote</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
