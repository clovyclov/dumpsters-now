---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TestimonialSlider from '../../components/TestimonialSlider.astro';
---

<BaseLayout
  title="Yard Debris Dumpster Rental Metro Detroit | Landscaping & Dirt"
  description="Rent yard debris roll-off dumpsters in Metro Detroit. Ideal for landscaping cleanups, brush, branches, sod, dirt & storm damage. Flat-rate pricing."
  canonical="https://dumpstersnow.com/yard-debris-dumpster-rental/"
  activePage="services"
>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="banner-pill">Landscaping & Outdoor Waste</span>

        <h1 class="hero-title">
          Yard Waste & Landscaping Roll-Off Dumpsters
        </h1>

        <p style="font-size:1.15rem; color:#e2e8f0; margin-bottom:25px;">
          Dispose of heavy soil, sod, tree limbs, shrub prunings, and storm debris with flat-rate roll-off containers delivered straight to your driveway.
        </p>

        <ul class="hero-features">
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Same-day & next-day delivery</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Driveway safe rubber wheels</li>
          <li><div class="check-icon"><svg viewBox="0 0 32 32"><path d="M27 4l-15 15-7-7-5 5 12 12 20-20z"/></svg></div>Flat-rate pricing with drop-off & pickup</li>
        </ul>

        <a href="/book-now/" class="btn btn-red">Book Yard Waste Dumpster</a>
      </div>

      <div class="hero-image-wrapper">
        <img src="/assets/images/WhatsApp Image 2023-05-06 at 12.52.43 PM.jpeg" alt="Yard Debris Dumpster Rental Metro Detroit" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- ==================== PRICING / SIZES SECTION (ALL 4 SIZES) ==================== -->
  <section class="pricing-section" id="pricing">
    <div class="container">
      <div class="section-header">
        <div class="section-subtitle">Yard Waste Sizes</div>
        <h2 class="section-title">Choose Your Yard Waste & Landscaping Dumpster</h2>
      </div>

      <div class="pricing-grid">
        <!-- 15 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">15 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$375</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="15 Yard Yard Debris Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Dirt, heavy sod, rocks & clay</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Garden cleanouts & shrub removal</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 15 Yard</a></div>
        </div>

        <!-- 20 Yard -->
        <div class="pricing-card popular-card">
          <div class="popular-badge">Most Popular</div>
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">20 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$425</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="20 Yard Yard Debris Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Tree branch trimming & stump removal</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Patio paver & deck land clearance</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-red btn-block">Rent 20 Yard</a></div>
        </div>

        <!-- 30 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">30 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$465</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="30 Yard Yard Debris Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Large property storm land clearing</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Commercial landscaping overhauls</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 30 Yard</a></div>
        </div>

        <!-- 40 Yard -->
        <div class="pricing-card">
          <div class="pricing-card-header">
            <h3 class="dumpster-size-title">40 Yard Dumpster</h3>
            <div class="price-box"><span class="price-label">Starting At</span><span class="price-value">$550</span></div>
          </div>
          <div class="pricing-card-img"><img src="/assets/images/dumpster-card-product.webp" alt="40 Yard Yard Debris Dumpster" loading="lazy" decoding="async"></div>
          <div class="pricing-card-body">
            <div class="best-used-heading">Best Used For:</div>
            <ul class="pricing-card-features">
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Major tree service & lot clearing</li>
              <li><svg viewBox="0 0 512 512"><path d="M256 8C119.033 8 8 119.033 8 256s111.033 248 248 248 248-111.033 248-248S392.967 8 256 8zm0 48c110.532 0 200 89.451 200 200 0 110.532-89.451 200-200 200-110.532 0-200-89.451-200-200 0-110.532 89.451-200 200-200m140.204 130.267l-22.536-22.718c-4.667-4.705-12.265-4.736-16.97-.068L215.346 303.697l-59.792-60.277c-4.667-4.705-12.265-4.736-16.97-.069l-22.719 22.536c-4.705 4.667-4.736 12.265-.068 16.971l90.781 91.516c4.667 4.705 12.265 4.736 16.97.068l172.589-171.204c4.704-4.668 4.734-12.266.067-16.971z"/></svg>Commercial land excavation waste</li>
            </ul>
          </div>
          <div class="pricing-card-footer"><a href="/book-now/" class="btn btn-outline btn-block">Rent 40 Yard</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 1: Image Left, Content Right -->
  <section style="padding: 60px 0; background: white;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dumpstersnow-real-7.webp" alt="Roll off dumpster for yard waste and landscaping" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
        <div>
          <div class="section-subtitle">Outdoor Landscaping & Yard Waste</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Clean Up Storm Debris, Trees, Sod & Outdoor Projects</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Tackling a major landscaping overhaul, clearing overgrown brush, or removing heavy tree stumps? Our roll-off dumpsters accept all organic yard waste and landscaping materials.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Perfect for heavy sod, dirt, branches, shrubs, bushes & tree limbs</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Convenient driveway & yard-adjacent placement with wooden protective skids</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Flat-rate disposal including local green waste processing & recycling</li>
          </ul>
          <a href="tel:888-870-9906" class="btn btn-red">Call Yard Debris Line: (888) 870-9906</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Alternating Feature Section 2: Content Left, Image Right -->
  <section style="padding: 60px 0; background: var(--bg-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px; align-items: center;">
        <div>
          <div class="section-subtitle">Efficient Organic Disposal</div>
          <h2 class="section-title" style="font-size: 2rem; margin-bottom: 15px;">Simplify Landscaping Cleanups & Patio Teardowns</h2>
          <p style="color: var(--text-dark); line-height: 1.7; font-size: 1.05rem; margin-bottom: 20px;">
            Skip the endless trips to the local yard waste facility in a pickup truck. Load all your brush, pavers, old fencing, and dirt directly into one convenient roll-off container.
          </p>
          <ul style="list-style: none; padding: 0; margin: 0 0 25px 0;">
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Low-side 15 & 20-yard options for easy shovel and wheelbarrow loading</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Handles heavy hardscape materials including retaining wall stone & pavers</li>
            <li style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-weight: 600; color: var(--navy-dark);"><span style="color: var(--primary-green); font-weight: 800; font-size: 1.2rem;">✓</span> Rapid delivery so you can tackle weekend outdoor projects with ease</li>
          </ul>
          <a href="#get-started" class="btn btn-green">Rent Yard Dumpster →</a>
        </div>
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
          <img src="/assets/images/dumpstersnow-real-3.webp" alt="Roll off dumpster for landscaping project" style="width: 100%; height: auto; display: block; object-fit: cover;" loading="lazy" decoding="async">
        </div>
      </div>
    </div>
  </section>


  <TestimonialSlider />

  <section class="quote-section" id="get-started">
    <div class="container quote-grid">
      <div class="quote-info">
        <div class="section-subtitle">Tidy Up Your Yard</div>
        <h2 class="section-title">Schedule Your Yard Debris Dumpster Delivery</h2>
        <p class="quote-desc">Get fast delivery for your weekend landscaping project or storm cleanup. Call (888) 870-9906.</p>
      </div>

      <div class="quote-form-card">
        <form id="quoteForm">
          <button type="submit" class="btn btn-green btn-block" style="padding:16px; margin-top:25px;">Get Yard Waste Quote</button>
        </form>
      </div>
    </div>
  </section>

  <section class="pre-footer-banner">
    <div class="container pre-footer-content">
      <div class="pre-footer-text">
        Get a reliable, convenient, and on-time dumpster delivered straight to your driveway.
      </div>
      <a href="/book-now/" class="btn btn-red">Book Online Today</a>
    </div>
  </section>
</BaseLayout>
