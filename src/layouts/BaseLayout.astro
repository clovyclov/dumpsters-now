---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  canonical?: string;
  activePage?: string;
  noindex?: boolean;
  hideHeader?: boolean;
  hideFooter?: boolean;
  faqSchema?: FaqItem[];
  breadcrumbName?: string;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  activePage = 'home',
  noindex = false,
  hideHeader = false,
  hideFooter = false,
  faqSchema = [],
  breadcrumbName
} = Astro.props;

// Build Breadcrumb Schema
const pathname = Astro.url.pathname.replace(/\/$/, '');
const isHome = pathname === '' || pathname === '/';
const breadcrumbsList = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://dumpstersnow.com/"
  }
];

if (!isHome) {
  const name = breadcrumbName || title.split('|')[0].trim();
  breadcrumbsList.push({
    "@type": "ListItem",
    "position": 2,
    "name": name,
    "item": canonical
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbsList
};

// Global WasteManagementService / LocalBusiness Schema
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "WasteManagementService",
  "@id": "https://dumpstersnow.com/#organization",
  "name": "Dumpsters Now",
  "legalName": "Dumpsters Now",
  "url": "https://dumpstersnow.com",
  "logo": "https://dumpstersnow.com/assets/images/dumpster-now-logo.png",
  "image": "https://dumpstersnow.com/assets/images/20230605_104913.webp",
  "telephone": "+1-888-870-9906",
  "email": "hysam@dumpstersnow.com",
  "priceRange": "$375-$550",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "7374 Chubb Rd",
    "addressLocality": "Northville",
    "addressRegion": "MI",
    "postalCode": "48168",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 42.4168,
    "longitude": -83.5135
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Northville" },
    { "@type": "City", "name": "Plymouth" },
    { "@type": "City", "name": "Livonia" },
    { "@type": "City", "name": "Canton" },
    { "@type": "City", "name": "Novi" },
    { "@type": "City", "name": "Detroit" },
    { "@type": "AdministrativeArea", "name": "Wayne County" },
    { "@type": "AdministrativeArea", "name": "Oakland County" },
    { "@type": "AdministrativeArea", "name": "Washtenaw County" },
    { "@type": "AdministrativeArea", "name": "Macomb County" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Roll-Off Dumpster Rental Services",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "15-Yard Roll-Off Dumpster Rental",
          "description": "Compact dumpster rental for garage cleanouts, small remodels, and yard waste."
        },
        "price": "375.00",
        "priceCurrency": "USD"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "20-Yard Roll-Off Dumpster Rental",
          "description": "Versatile dumpster container for kitchen remodels, roof tear-offs, and multi-room cleanouts."
        },
        "price": "425.00",
        "priceCurrency": "USD"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "30-Yard Roll-Off Dumpster Rental",
          "description": "Large roll-off dumpster for whole-house renovations, estate purges, and construction debris."
        },
        "price": "465.00",
        "priceCurrency": "USD"
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "40-Yard Roll-Off Dumpster Rental",
          "description": "Extra-large dumpster for commercial teardowns, major construction projects, and bulk waste."
        },
        "price": "550.00",
        "priceCurrency": "USD"
      }
    ]
  }
};

// Optional FAQPage Schema
const faqJsonLd = faqSchema.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSchema.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-WNBNC4JK');</script>
  <!-- End Google Tag Manager -->

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical}>

  <!-- Favicon & Touch Icons -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <!-- OpenGraph Meta Tags -->
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Dumpsters Now" />
  <meta property="og:image" content="https://dumpstersnow.com/assets/images/dumpster-now-logo.png" />

  <!-- Google Fonts: Montserrat & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet">

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/styles.css">

  <!-- Structured JSON-LD Schemas -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <slot name="head" />
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-WNBNC4JK"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  {!hideHeader && <Header activePage={activePage} />}

  <main>
    <slot />
  </main>

  {!hideFooter && <Footer />}

  <!-- Main Client-Side JavaScript -->
  <script is:inline src="/script.js"></script>
</body>
</html>
